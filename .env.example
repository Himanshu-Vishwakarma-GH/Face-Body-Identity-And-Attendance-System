# Application Configuration
PROJECT_NAME="AI Based Face & Body Detection Access Control System"
ENVIRONMENT=development
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# Redis Database Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_FALLBACK_MEMORY=true

# Security & Cryptography
# Generate a 32-byte base64-encoded key for AES-256: e.g. python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AES_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItYWVzIQ==
JWT_SECRET=super-secret-jwt-signing-key-for-ibm-hackathon-2026-replace-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Initial Admin Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_EMAIL=admin@security.local

# AI & Verification Thresholds
FACE_SIMILARITY_THRESHOLD=0.60
BODY_DISTANCE_THRESHOLD=0.35
TAILGATE_DETECTION_WINDOW_SEC=5
PERSON_CONFIDENCE_THRESHOLD=0.50

# Camera & Health Monitoring
CAMERA_HEARTBEAT_INTERVAL_SEC=30
CAMERA_TIMEOUT_THRESHOLD_SEC=120
DEFAULT_CAMERA_ID=CAM-01
DEFAULT_CAMERA_RTSP=0

# Storage Directories
DATA_DIR=./data
FACES_DIR=./data/faces
MODELS_DIR=./ml/models
